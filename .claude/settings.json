{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'This repository runs under pstack. Start sessions on this repo with /pstack:poteto-mode. Only the user can run it; if this session did not start with it, remind the user once.'"
          },
          {
            "type": "command",
            "command": "command -v dotnet >/dev/null && dotnet tool restore >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-stop.sh",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "superpowers@synced": false,
    "backend-design@synced": false
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  }
}
