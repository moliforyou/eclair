# Copy to .env (gitignored) or export in your shell to override appsettings.json.
# .NET maps double-underscore env vars onto config keys (ConnectionStrings__X -> ConnectionStrings:X).

# Postgres — defaults match docker-compose.yml
ConnectionStrings__Postgres="Host=localhost;Database=chess;Username=postgres;Password=postgres"

# Redis — defaults match docker-compose.yml
ConnectionStrings__Redis="localhost:6379"

# Backend listen URL
Urls="http://localhost:5000"
