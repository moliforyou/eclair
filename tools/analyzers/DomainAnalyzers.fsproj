<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- One fixed folder for every configuration, so ./eclair analyze always finds the assembly. -->
    <OutputPath>bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- BOOTSTRAP (temporary): no lock file yet. -->
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DomainRules.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Analyzers.SDK" />
    <!-- The fsharp-analyzers tool supplies FSharp.Core at run time; the SDK needs this version to compile. -->
    <PackageReference Update="FSharp.Core" VersionOverride="10.1.404" />
  </ItemGroup>

</Project>
